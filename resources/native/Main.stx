<script client>
import { actionCandidates, actionSymbol } from '../functions/browser/actions'
import { displayHost, displayTitle, resolveInput } from '../functions/browser/address'
import { tabsToSleep } from '../functions/browser/hibernation'
import { createHistoryClient } from '../functions/browser/history-client'
import { browserMenus } from '../functions/browser/keymap'
import { applyDownload, createLibraryClient, downloadFraction, formatBytes, formatTime, groupByDay } from '../functions/browser/library'
import { createBlocker } from '../functions/browser/blocker'
import { boostScripts, createBoostClient, newBoost, ZAP_SCRIPT, zapReadScript } from '../functions/browser/boosts'
import { addSpace, rowMenu, runRowAction, runSpaceAction, spaceMenu } from '../functions/browser/menus'
import { mergeImported } from '../functions/browser/arc-import'
import { createImportClient, importSummary, keepSignedIn, nextStep, SETTLE_IN_TIPS, signInOffer, signInSummary } from '../functions/browser/onboarding'
import { createPages } from '../functions/browser/pages'
import { shouldPeek } from '../functions/browser/peek'
import { rank } from '../functions/browser/rank'
import { createSessionClient, diffSession } from '../functions/browser/session'
import { archiveAfterMs, readSettings } from '../functions/browser/settings'
import { THEME_PRESETS, themeFromColors } from '../functions/browser/theme'
import { createSitesClient, decide, permissionWords, remember, settingsFor, siteKey, stepZoom, unblockedHosts } from '../functions/browser/sites'
import { createSuggestionClient } from '../functions/browser/suggestions'
import { applySharedChange, sharedChange, shownElsewhere, snapshot, windowMessage, withView } from '../functions/browser/windows'
import { addFavorite, autoArchive, clearToday, closeTab, createState, newId, leaveSplit, moveItem, openTab, pinTab, renameItem, reopenClosed, rows, selectTab, splitOf, splitTabs, switchSpace, tabOrder, unpinTab, updateItem, updateSpace } from '../functions/browser/sidebar'

const web = craft.web
// A private window keeps nothing: no saved sidebar, no history, pages in a store that never touches disk.
const isPrivate = Boolean(craft.route && craft.route.params && craft.route.params.private)
// A window opened with ⌘N shares the main window's sidebar (windows.ts). Only the main window saves
// which space and tab it shows, takes links from other apps, and adopts the Little window's pages.
const isExtraWindow = Boolean(craft.route && craft.route.params && craft.route.params.window)
let savedView = null
// Tabs the other windows show, by window: a page can be in one window at a time.
const elsewhere = state({})
const elsewhereTabs = derived(() => shownElsewhere(elsewhere()))
// Other windows' changes that arrived before this one had loaded the sidebar.
const waitingChanges = []
const PRIVATE_THEME = {
  light: { background: '#3b2f63', backgroundTo: '#241c42', foreground: '#f1edff', hover: '#ffffff1a', selected: '#ffffff2e' },
  dark: { background: '#2a2147', backgroundTo: '#18122e', foreground: '#f1edff', hover: '#ffffff1a', selected: '#ffffff2e' },
}
// The sidebar lives in the agent's database (app/Desktop/Agent.ts); it draws once that answers.
const sessionClient = createSessionClient({ base: craft.app.url || '' })
const browser = state(createState(isPrivate ? { name: 'Private', icon: '🕶️', theme: PRIVATE_THEME } : { name: 'Personal' }))
const restored = state(false)
let persisting = false
const scheme = state(craft.appearance.colorScheme())
craft.appearance.onChange(next => scheme.set(next))

const space = derived(() => browser().spaces.find(each => each.id === browser().activeSpace) ?? browser().spaces[0])
const palette = derived(() => space().theme[scheme()])
const favorites = derived(() => rows(browser(), 'favorites'))
const pinned = derived(() => rows(browser(), 'pinned'))
const today = derived(() => rows(browser(), 'today'))
const shownId = derived(() => browser().selected[browser().activeSpace] ?? null)
const shownTab = derived(() => (shownId() ? browser().items[shownId()] : null))
// A tab in a split view shows beside the others; the one picked last is the one the toolbar drives.
const panes = derived(() => {
  const id = shownId()
  if (!id) return []
  const split = splitOf(browser(), id)
  return split ? split.panes : [browser().items[id]].filter(Boolean)
})

// What each live page reports: title, address, progress, history.
const pageState = state({})
const shownPage = derived(() => (shownId() ? pageState()[shownId()] ?? null : null))
const progress = derived(() => (shownPage()?.loading ? Math.max(0.08, shownPage().progress) : 0))
const sidebarOpen = state(craft.storage.getSync('browser.sidebarOpen') !== false)
// With the sidebar hidden, pointing at the window's left edge brings it back over the page.
const peeking = state(false)
const sidebarShown = derived(() => sidebarOpen() || peeking())
let peekTimer = null
function peekSidebar(hovered) {
  clearTimeout(peekTimer)
  if (hovered) return peeking.set(true)
  peekTimer = setTimeout(() => peeking.set(false), 250)
}
const renamingSpace = state(null)
const spaceText = state('')
const hoveredRow = state(null)
const dropAt = state(null)
const pages = createPages(web, { private: isPrivate })
// Visits go to the app's own agent, which keeps and searches them (app/Desktop/Agent.ts).
const historyClient = createHistoryClient({ base: craft.app.url || '', isPrivate: () => isPrivate })
// What the browser remembers per site (blocker, zoom, camera and microphone), and the ad blocker.
const sitesClient = createSitesClient({ base: craft.app.url || '' })
const sites = state({})
const blocker = createBlocker({ base: craft.app.url || '', web })
const shownSite = derived(() => settingsFor(sites(), siteKey(shownTab() && shownTab().url)))
const siteControls = state(false)
// Requests for the camera or microphone waiting for an answer, oldest first.
const permissionRequests = state([])
const permissionShown = derived(() => permissionRequests()[0] ?? null)
// Find on page.
const finding = state(false)
const findText = state('')
const findFound = state(true)
// The downloads popover over the sidebar's footer.
const downloadsOpen = state(false)
const activeDownloads = derived(() => downloadList().filter(download => download.state === 'started').length)
// Peek: a link out of a pinned tab or favorite, over the page.
const peek = state(null)
// Boosts: each site's own CSS, JS and zapped elements.
const boostClient = createBoostClient({ base: craft.app.url || '' })
const boosts = state([])
// First launch: a few steps over the window (onboarding.ts).
const importClient = createImportClient({ base: craft.app.url || '' })
const onboarding = state(!isPrivate && !isExtraWindow && craft.storage.getSync('browser.onboarded') !== true ? 'welcome' : null)
const arcPreview = state(null)
const importing = state(false)
const imported = state('')
const keepingSignIns = state(false)
const signedIn = state('')
const shownBoost = derived(() => (shownSite() ? boosts().find(boost => boost.host === shownSite().host) ?? null : null))
const boostEditor = state(false)
const zapping = state(false)
const libraryClient = createLibraryClient({ base: craft.app.url || '' })

// A row being renamed in place.
const renaming = state(null)
const renameText = state('')

// The Library: what left the sidebar, what was visited, what was downloaded.
const LIBRARY_SECTIONS = [{ id: 'archive', title: 'Archive' }, { id: 'history', title: 'History' }, { id: 'downloads', title: 'Downloads' }]
const library = state(null)
const libraryText = state('')
const archivedTabs = state([])
const visitedPages = state([])
const savedDownloads = state([])
// Downloads running now, by id, as Craft reports them.
const liveDownloads = state({})
const downloadList = derived(() => {
  const live = liveDownloads()
  return [...Object.values(live), ...savedDownloads().filter(each => !live[each.id])]
})
const libraryGroups = derived(() => {
  const section = library()
  if (section === 'archive') return groupByDay(archivedTabs(), tab => tab.archivedAt)
  if (section === 'history') return groupByDay(visitedPages(), page => page.lastVisitAt)
  if (section === 'downloads') return groupByDay(downloadList(), download => download.startedAt)
  return []
})

// The command bar: a new tab (cmd-T) or this tab's address (cmd-L).
const commanding = state(null)
const commandText = state('')
const highlighted = state(0)
const historyMatches = state([])
const suggestionMatches = state([])
const settings = state(readSettings(key => craft.storage.getSync(key)))
const searchEngine = derived(() => settings().searchEngine)
const suggestClient = createSuggestionClient({ base: craft.app.url || '' })
const RESULT_SYMBOLS = { tab: 'square.on.square', pinned: 'pin', history: 'clock', suggestion: 'magnifyingglass' }
const ENGINE_NAMES = { google: 'Google', duckduckgo: 'DuckDuckGo', kagi: 'Kagi', bing: 'Bing', ecosia: 'Ecosia', brave: 'Brave' }
const results = derived(() => {
  if (!commanding()) return []
  const text = commandText().trim()
  const target = resolveInput(text, searchEngine())
  const lead = target ? [{ kind: target.kind === 'url' ? 'go' : 'search', id: 'go', title: target.kind === 'url' ? target.url : 'Search ' + (ENGINE_NAMES[searchEngine()] || 'the web') + ' for “' + text + '”', url: target.url, symbol: target.kind === 'url' ? 'globe' : 'magnifyingglass' }] : []
  if (!text) return lead
  const tabs = Object.values(browser().items).filter(item => item.kind === 'tab' && item.url)
    .map(item => ({ kind: item.section === 'today' ? 'tab' : 'pinned', id: item.id, title: titleOf(item), url: item.url, icon: iconFor(item) }))
  const candidates = [...tabs, ...historyMatches(), ...(commanding() === 'new' || commanding() === 'address' ? actionCandidates(Boolean(shownTab())) : []), ...suggestionMatches()]
  return [...lead, ...rank(text, candidates, 8).map(result => ({ ...result, symbol: result.kind === 'action' ? actionSymbol(result.id) : RESULT_SYMBOLS[result.kind] }))]
})

// History and suggestions answer a moment after typing pauses; an answer for older text is dropped.
let historyTimer = null
effect(() => {
  const text = commanding() ? commandText().trim() : ''
  clearTimeout(historyTimer)
  if (!text) {
    historyMatches.set([])
    return suggestionMatches.set([])
  }
  historyTimer = setTimeout(async () => {
    const [found, suggested] = await Promise.all([historyClient.search(text, 8), suggestClient(text, searchEngine())])
    if (!commanding() || commandText().trim() !== text) return
    historyMatches.set(found)
    suggestionMatches.set(suggested)
  }, 60)
})

function apply(next) {
  if (next === browser()) return
  const change = isPrivate ? null : sharedChange(diffSession(browser(), next))
  browser.set(next)
  if (persisting) sessionClient.save(isExtraWindow && savedView ? withView(next, savedView) : next)
  if (change) craft.desktop.post({ type: 'sidebar', change })
}
/** Another window's sidebar change: applied here and counted as saved, because that window saves it. */
function applyRemote(change, replace) {
  if (!restored()) return waitingChanges.push([change, replace])
  const update = current => applySharedChange(current, change, { replace })
  sessionClient.acknowledge(update)
  browser.set(update(browser()))
}

/**
 * The saved sidebar, else the one an older build kept in UserDefaults (moved
 * into the database once it is safely there), else a fresh one. If the agent
 * cannot answer, nothing is written: a partial sidebar must never replace the
 * saved one.
 */
async function restore() {
  if (isPrivate) {
    restored.set(true)
    return openCommand('new')
  }
  let saved = null
  try {
    saved = await sessionClient.load()
    persisting = true
  }
  catch (error) { console.error('Browser: the sidebar could not be loaded; changes this run are not kept.', error) }
  const legacy = saved || isExtraWindow ? null : craft.storage.getSync('browser.sidebar')
  browser.set(saved ?? (legacy && legacy.spaces ? legacy : browser()))
  if (isExtraWindow) {
    // This window starts in the opener's space with no tab picked; the saved view stays the main window's.
    savedView = { activeSpace: browser().activeSpace, selected: browser().selected }
    const wanted = craft.route.params.space
    const start = browser().spaces.some(each => each.id === wanted) ? wanted : browser().activeSpace
    browser.set({ ...browser(), activeSpace: start, selected: { ...browser().selected, [start]: null } })
  }
  restored.set(true)
  for (const [change, replace] of waitingChanges.splice(0)) applyRemote(change, replace)
  craft.desktop.post({ type: 'hello' })
  if (persisting && !saved && !isExtraWindow) {
    sessionClient.save(browser())
    if (await sessionClient.flush() && legacy) craft.storage.remove('browser.sidebar')
  }
  // A first launch waits for onboarding, whose import may fill the sidebar.
  if ((isExtraWindow || !Object.keys(browser().items).length) && !onboarding()) openCommand('new')
}

// Pages wait for the blocker's lists (WebKit has them compiled from an earlier
// run, so it is quick), or 1.5 s if the agent is slow: no first load goes unblocked.
const blockerReady = state(false)
setTimeout(() => blockerReady.set(true), 1500)
effect(() => {
  if (!blockerReady()) return
  for (const tab of panes()) {
    if (tab.kind === 'tab' && tab.url && !elsewhereTabs().has(tab.id)) pages.show(tab, space().profile)
  }
})

function rowStyle(row) {
  const item = row.item ?? row
  const showing = item.id === shownId() || (row.panes && row.panes.some(pane => pane.id === shownId()))
  return showing ? { backgroundColor: palette().selected } : {}
}
function textStyle() { return { color: palette().foreground } }
// Icons that failed to load (a site with no /favicon.ico) fall back to the globe for this run.
const brokenIcons = state({})
function iconFor(item) { return item.icon && item.icon.startsWith('http') && !brokenIcons()[item.icon] ? item.icon : '' }
function iconFailed(url) { if (url && !brokenIcons()[url]) brokenIcons.set({ ...brokenIcons(), [url]: true }) }
function emojiFor(item) { return item.icon && !item.icon.startsWith('http') ? item.icon : '' }
/** A space's icon is an emoji or an SF Symbol name (Arc's spaces bring symbols). */
function isSymbol(icon) { return Boolean(icon) && /^[a-z0-9]+(\.[a-z0-9]+)*$/.test(icon) }
function titleOf(item) { return item.name || displayTitle(item.title, item.url) }
/** A split view's row reads as its tabs' titles side by side. */
function rowTitle(row) { return row.panes ? row.panes.map(titleOf).join('  |  ') : titleOf(row.item) }
function isSplitRow(row) { return Boolean(row.panes) }

function newTab(url, background = false) {
  apply(openTab(browser(), { url, background }).state)
}
function show(id) { apply(selectTab(browser(), id)) }
function close(id) {
  const result = closeTab(browser(), id)
  apply(result.state)
  if (result.removed) pages.release([id])
  historyClient.forgetTab(id)
}
function textOf(event) {
  if (typeof event === 'string') return event
  const value = event?.nativeEvent?.text ?? event?.text ?? event?.value
  return typeof value === 'string' ? value : ''
}

function openCommand(mode) {
  commandText.set(mode === 'address' && shownTab() ? shownTab().url : '')
  highlighted.set(0)
  commanding.set(mode)
}
function typeCommand(event) {
  commandText.set(textOf(event))
  highlighted.set(0)
}
function steer(event) {
  const count = results().length
  if (!count) return
  const step = event.key === 'ArrowUp' || (event.key === 'Tab' && event.shiftKey) ? -1 : 1
  highlighted.set((highlighted() + step + count) % count)
}
function pick(index) {
  const chosen = results()[index]
  if (!chosen || chosen.id === 'go') return submitCommand()
  if (chosen.kind === 'history' || chosen.kind === 'suggestion') return go(chosen.url)
  if (chosen.kind === 'action') {
    commanding.set(null)
    splitting = null
    return commands[chosen.id] && commands[chosen.id]()
  }
  commanding.set(null)
  if (splitting && browser().items[splitting]) {
    apply(splitTabs(browser(), splitting, chosen.id).state)
    splitting = null
    return
  }
  show(chosen.id)
}
/** Opens an address: in this tab from cmd-L, in a new one from cmd-T. */
function go(url) {
  const mode = commanding()
  commanding.set(null)
  if (mode === 'address' && shownId()) {
    apply(updateItem(browser(), shownId(), { url }))
    web.navigate(shownId(), url)
  }
  else if (splitting && browser().items[splitting]) {
    const opened = openTab(browser(), { url, background: true })
    apply(splitTabs(opened.state, splitting, opened.tab.id).state)
    splitting = null
  }
  else newTab(url)
}
function submitCommand() {
  const target = resolveInput(commandText(), searchEngine())
  if (!target) return commanding.set(null)
  go(target.url)
}

// Right-clicking a row: what it offers depends on the row and the tab on screen (menus.ts).
async function openRowMenu(item) {
  const chosen = await craft.desktop.contextMenu(rowMenu(browser(), item, shownId()))
  const latest = chosen ? browser().items[item.id] : null
  if (!latest) return
  const { state: next, effect } = runRowAction(browser(), latest, chosen, shownId())
  apply(next)
  if (effect && effect.kind === 'copy') craft.clipboard && craft.clipboard.setString(effect.text)
  if (effect && effect.kind === 'rename') startRename(effect.id)
  if (effect && effect.kind === 'close') close(effect.id)
}

async function openSpaceMenu(spaceId) {
  const chosen = await craft.desktop.contextMenu(spaceMenu(browser(), spaceId))
  if (chosen) spaceAction(runSpaceAction(browser(), spaceId, chosen))
}
function spaceAction({ state: next, effect }) {
  apply(next)
  if (effect && effect.kind === 'rename-space') {
    spaceText.set(browser().spaces.find(each => each.id === effect.id)?.name || '')
    renamingSpace.set(effect.id)
  }
  if (effect && effect.kind === 'released') pages.release(effect.tabs)
}
function finishSpaceRename() {
  const id = renamingSpace()
  if (!id) return
  renamingSpace.set(null)
  if (spaceText().trim()) apply(updateSpace(browser(), id, { name: spaceText().trim() }))
}

function saveSite(settings) {
  sites.set({ ...sites(), [settings.host]: settings })
  sitesClient.save(settings)
  blocker.allow(unblockedHosts(sites())).catch(() => {})
}
function zoomBy(direction) {
  const site = shownSite()
  if (!site || !shownId()) return
  const zoom = direction === 0 ? 1 : stepZoom(site.zoom, direction)
  web.setZoom(shownId(), zoom)
  saveSite({ ...site, zoom })
}
function toggleBlocking() {
  const site = shownSite()
  if (!site) return
  saveSite({ ...site, blocking: !site.blocking })
  // The page loads again with its new rules, as Arc does.
  if (shownId()) web.reload(shownId())
}
async function clearSiteData() {
  const site = shownSite()
  if (!site) return
  siteControls.set(false)
  await web.clearData({ profile: space().profile, private: isPrivate, host: site.host }).catch(() => {})
  if (shownId()) web.reload(shownId())
}
function setDevice(kind, decision) {
  const site = shownSite()
  if (site) saveSite({ ...site, [kind]: decision })
}

/** A site asks for the camera or microphone: a remembered answer goes straight back, otherwise the window asks. */
function onPermission(event) {
  const settings = settingsFor(sites(), event.origin.replace(/^www\./, ''))
  const decision = settings ? decide(settings, event.kind) : 'ask'
  if (decision !== 'ask') return web.answerPermission(event.request, decision === 'allow' ? 'grant' : 'deny')
  permissionRequests.set([...permissionRequests(), event])
}
function answerPermission(allow) {
  const request = permissionShown()
  if (!request) return
  permissionRequests.set(permissionRequests().slice(1))
  web.answerPermission(request.request, allow ? 'grant' : 'deny')
  const settings = settingsFor(sites(), request.origin.replace(/^www\./, ''))
  if (settings) saveSite(remember(settings, request.kind, allow ? 'allow' : 'deny'))
}

function openFind() {
  if (!shownId()) return
  finding.set(true)
  if (findText()) findNext(false)
}
function typeFind(event) {
  findText.set(textOf(event))
  findNext(false)
}
async function findNext(backwards) {
  if (!shownId() || !findText()) return findFound.set(true)
  const answer = await web.find(shownId(), findText(), { backwards }).catch(() => ({ found: false }))
  findFound.set(Boolean(answer && answer.found))
}

const DEVICE_CHOICES = [{ label: 'Ask', value: 'ask' }, { label: 'Allow', value: 'allow' }, { label: 'Block', value: 'deny' }]
function showAllDownloads() {
  downloadsOpen.set(false)
  openLibrary('downloads')
}

/** A link another app opened (this browser being the default): a small window above the rest, or a Today tab. */
function openExternal(url) {
  if (isPrivate || typeof url !== 'string' || !url) return
  if (settings().littleWindowForLinks) return openLittle(url)
  newTab(url)
}
function openLittle(url) {
  craft.desktop.openWindow({ name: 'little-' + Date.now().toString(36), route: 'Little', title: 'Little Window', titlebarStyle: 'transparent', floating: true, width: 780, height: 580, minWidth: 420, minHeight: 320, trafficLights: [14, 13], params: url ? { url } : {} })
}
function openSettings() {
  craft.desktop.openWindow({ name: 'settings', route: 'Settings', title: 'Settings', titlebarStyle: 'transparent', width: 620, height: 640, minWidth: 520, minHeight: 480, trafficLights: [16, 16] })
}
/** Another window says something: the sidebar changed, it shows tabs, the Little window hands over a page, or settings changed. */
function onWindowMessage(message, from) {
  if (!message || typeof message !== 'object' || isPrivate) return
  const shared = windowMessage(message)
  if (shared && shared.type === 'sidebar') applyRemote(shared.change, shared.replace === true)
  if (shared && shared.type === 'hello') {
    craft.desktop.post({ type: 'showing', tabs: showing() })
    if (restored()) craft.desktop.post({ type: 'sidebar', change: snapshot(browser()), replace: true })
  }
  if (shared && shared.type === 'showing') elsewhere.set({ ...elsewhere(), [from]: shared.tabs })
  if (shared && shared.type === 'take' && showing().includes(shared.tab)) {
    // The other window shows it from now on; this one draws the card instead.
    pages.forget(shared.tab)
    elsewhere.set({ ...elsewhere(), [from]: [...(elsewhere()[from] || []), shared.tab] })
  }
  if (message.type === 'adopt' && typeof message.tab === 'string' && !isExtraWindow) {
    apply(openTab(browser(), { id: message.tab, url: message.url || 'about:blank', title: message.title || undefined }).state)
    pages.adopt(message.tab)
    // Once this window shows it, the tab is this window's, and the small one may close.
    setTimeout(() => craft.desktop.post({ type: 'adopted', tab: message.tab }), 200)
  }
  if (message.type === 'settings') applySettings(readSettings(key => craft.storage.getSync(key)))
}
/** Tabs this window draws a page for. */
function showing() {
  return [...panes().map(pane => pane.id), ...(peek() ? [peek().tab] : [])].filter(id => !elsewhereTabs().has(id))
}
/** A tab another window shows, brought here: that window lets it go, and this one shows it. */
function takeTab(id) {
  craft.desktop.post({ type: 'take', tab: id })
  const next = {}
  for (const [name, tabs] of Object.entries(elsewhere())) next[name] = tabs.filter(each => each !== id)
  elsewhere.set(next)
}
/** A window closed, and Craft closed its pages: forget them here so showing them again makes new ones. */
async function onWindowClosed(name) {
  const next = { ...elsewhere() }
  delete next[name]
  elsewhere.set(next)
  const live = await web.list().catch(() => null)
  if (live) pages.prune(new Set(live.map(page => page.tab)))
}
async function openNewWindow() {
  // The new window loads the sidebar from the agent, so what is waiting goes first.
  await sessionClient.flush()
  craft.desktop.openWindow({ name: 'window-' + Date.now().toString(36), route: 'Main', title: 'Browser', titlebarStyle: 'transparent', width: 1180, height: 780, minWidth: 900, minHeight: 560, trafficLights: [18, 15], params: { window: true, space: browser().activeSpace } })
}
function applySettings(next) {
  const before = settings()
  settings.set(next)
  if (before.blocking !== next.blocking || before.cookieConsent !== next.cookieConsent)
    blocker.setEnabled(next.blocking, { cookieConsent: next.cookieConsent }).catch(() => {})
}

/** A link from a pinned tab or favorite to another site opens in Peek instead of a new tab. */
function openPeek(url, child) {
  const tab = child || newId()
  if (peek()) pages.release([peek().tab])
  pages.adopt(tab)
  if (!child) web.create({ id: tab, url, profile: space().profile, private: isPrivate })
  peek.set({ tab, url, title: '' })
}
function closePeek() {
  if (!peek()) return
  pages.release([peek().tab])
  peek.set(null)
}
function keepPeek() {
  const opened = peek()
  if (!opened) return
  peek.set(null)
  apply(openTab(browser(), { id: opened.tab, url: opened.url, title: opened.title || undefined }).state)
}

function saveBoost(boost) {
  boosts.set([...boosts().filter(each => each.id !== boost.id), boost])
  boostClient.save(boost)
  blocker.setBoosts(boostScripts(boosts())).catch(() => {})
  // The page gets the new CSS now; scripts run from its next load.
  if (shownId()) {
    const css = boost.enabled ? [boost.css, boost.zapped.length ? boost.zapped.join(',') + ' { display: none !important; }' : ''].join('\n') : ''
    web.evaluate(shownId(), '(() => { let s = document.getElementById("craft-boost-live"); if (!s) { s = document.createElement("style"); s.id = "craft-boost-live"; (document.head || document.documentElement).appendChild(s) } s.textContent = ' + JSON.stringify(css) + ' })()', { isolated: true }).catch(() => {})
  }
}
function openBoost() {
  const site = shownSite()
  if (!site) return
  siteControls.set(false)
  if (!shownBoost()) saveBoost(newBoost(site.host, newId()))
  boostEditor.set(true)
}
function editBoost(field, value) {
  const boost = shownBoost()
  if (boost) saveBoost({ ...boost, [field]: value })
}
async function deleteBoost() {
  const boost = shownBoost()
  if (!boost) return
  boostEditor.set(false)
  boosts.set(boosts().filter(each => each.id !== boost.id))
  await boostClient.remove(boost.id)
  blocker.setBoosts(boostScripts(boosts())).catch(() => {})
  if (shownId()) web.reload(shownId())
}
let zapTimer = null
async function toggleZap() {
  if (!shownId()) return
  if (zapping()) return stopZap()
  zapping.set(true)
  await web.evaluate(shownId(), ZAP_SCRIPT, { isolated: true }).catch(() => zapping.set(false))
  zapTimer = setInterval(() => collectZapped(false), 500)
}
async function collectZapped(stop) {
  if (!shownId()) return
  const raw = await web.evaluate(shownId(), zapReadScript(stop), { isolated: true }).catch(() => '[]')
  const picked = JSON.parse(typeof raw === 'string' ? raw : '[]')
  const boost = shownBoost()
  if (boost && picked.length) saveBoost({ ...boost, zapped: [...new Set([...boost.zapped, ...picked])] })
}
function stopZap() {
  clearInterval(zapTimer)
  zapping.set(false)
  collectZapped(true)
}

async function advanceOnboarding() {
  const next = nextStep(onboarding())
  if (!next) return finishOnboarding()
  onboarding.set(next)
  if (next === 'import' && !arcPreview()) arcPreview.set(await importClient.preview())
}
function finishOnboarding() {
  onboarding.set(null)
  craft.storage.setSync('browser.onboarded', true)
  if (!Object.keys(browser().items).length) openCommand('new')
}
/** Arc's sidebar into this one, and its history into the agent. */
async function importArc() {
  importing.set(true)
  const result = await importClient.run()
  importing.set(false)
  if (!result) return imported.set('Arc\'s data could not be read.')
  if (result.state) apply(mergeImported(browser(), result.state))
  imported.set('Brought over ' + importSummary(result.report || undefined, result.historyImported) + '.')
}
/** Arc's sign-ins into each profile's WebKit store; macOS asks before the agent can read them. */
async function keepArcSignIns() {
  keepingSignIns.set(true)
  const result = await importClient.signIns()
  if (result.data) {
    const kept = await keepSignedIn(result.data, craft.web, browser().spaces.map(each => each.profile)).catch(() => null)
    signedIn.set(kept ? signInSummary(kept) : 'WebKit did not take Arc\'s sign-ins.')
  }
  else signedIn.set(result.error)
  keepingSignIns.set(false)
}
function pickTheme(preset) {
  apply(updateSpace(browser(), space().id, { theme: themeFromColors(preset.colors) }))
}
async function onboardDefault() {
  await craft.desktop.setDefaultBrowser().catch(() => false)
  advanceOnboarding()
}

function openPrivateWindow() {
  craft.desktop.openWindow({ name: 'private-' + Date.now().toString(36), route: 'Main', title: 'Private', titlebarStyle: 'transparent', width: 1180, height: 780, minWidth: 900, minHeight: 560, trafficLights: [18, 15], params: { private: true } })
}

function startRename(id) {
  const item = browser().items[id]
  if (!item) return
  renameText.set(item.kind === 'folder' ? item.title || '' : titleOf(item))
  renaming.set(id)
}
function finishRename() {
  const id = renaming()
  if (!id) return
  renaming.set(null)
  const item = browser().items[id]
  // Keeping the page's own title is not a rename.
  if (item && (item.kind === 'folder' || renameText().trim() !== displayTitle(item.title, item.url))) apply(renameItem(browser(), id, renameText()))
}

/** cmd-shift-=: the tab on screen gets a new tab beside it, chosen from the command bar. */
function splitWithNew() {
  if (!shownId()) return openCommand('new')
  splitting = shownId()
  openCommand('new')
}
let splitting = null

/** The page's HTML as text, in a tab beside it. */
async function viewSource() {
  if (!shownId()) return
  const html = await web.evaluate(shownId(), 'document.documentElement.outerHTML', { isolated: true }).catch(() => null)
  if (typeof html === 'string') newTab('data:text/plain;charset=utf-8,' + encodeURIComponent(html))
}

async function openLibrary(section) {
  library.set(section)
  libraryText.set('')
  if (section === 'archive') archivedTabs.set(await libraryClient.archived())
  if (section === 'history') visitedPages.set(await libraryClient.history())
  if (section === 'downloads') savedDownloads.set(await libraryClient.downloads())
}
let libraryTimer = null
function typeLibrary(event) {
  const text = textOf(event)
  libraryText.set(text)
  clearTimeout(libraryTimer)
  libraryTimer = setTimeout(async () => {
    const found = await libraryClient.history(text)
    if (library() === 'history' && libraryText() === text) visitedPages.set(found)
  }, 80)
}
function openFromLibrary(entry) {
  const section = library()
  library.set(null)
  if (section === 'archive') {
    // The archived row comes back as it was, under its own id, so the agent un-archives it.
    apply(openTab(browser(), { id: entry.id, url: entry.url, title: entry.title }).state)
    archivedTabs.set(archivedTabs().filter(tab => tab.id !== entry.id))
  }
  else if (section === 'history') newTab(entry.url)
  else if (section === 'downloads' && entry.state === 'finished') web.openDownload(entry.path).catch(() => {})
}
function downloadDetail(download) {
  if (download.state === 'failed') return 'Failed'
  if (download.state === 'finished') return formatBytes(download.total || download.received)
  const fraction = downloadFraction(download)
  return fraction === null ? formatBytes(download.received) : formatBytes(download.received) + ' of ' + formatBytes(download.total)
}
function entryTitle(entry) { return library() === 'downloads' ? entry.name || entry.url : entry.title || displayTitle('', entry.url) }
function entryDetail(entry) {
  if (library() === 'downloads') return downloadDetail(entry)
  return displayHost(entry.url) + '  ·  ' + formatTime(library() === 'archive' ? entry.archivedAt : entry.lastVisitAt)
}

function drop(row, event) {
  dropAt.set(null)
  const id = event.data
  if (typeof id === 'string' && id !== row.item.id) {
    const place = event.position === 'inside' ? { inside: row.item.id } : event.position === 'before' ? { before: row.item.id } : { after: row.item.id }
    apply(moveItem(browser(), id, place))
  }
  else if (event.urls && event.urls[0]) newTab(event.urls[0])
}
function dropOnFavorites(event) {
  if (typeof event.data === 'string') apply(addFavorite(browser(), event.data))
}

function cycle(step) {
  const order = tabOrder(browser())
  if (!order.length) return
  const index = order.findIndex(tab => tab.id === shownId())
  show(order[(index + step + order.length) % order.length].id)
}

const commands = {
  'new-tab': () => openCommand('new'),
  'open-location': () => openCommand('address'),
  'close-tab': () => shownId() && close(shownId()),
  'reopen-closed': () => apply(reopenClosed(browser()).state),
  'toggle-sidebar': () => {
    sidebarOpen.set(!sidebarOpen())
    peeking.set(false)
    craft.storage.setSync('browser.sidebarOpen', sidebarOpen())
  },
  'new-space': () => spaceAction(addSpace(browser())),
  'pin-tab': () => shownTab() && apply(shownTab().section === 'today' ? pinTab(browser(), shownId()) : unpinTab(browser(), shownId())),
  'copy-url': () => shownTab() && craft.clipboard && craft.clipboard.setString(shownTab().url),
  'reload': () => shownId() && web.reload(shownId()),
  'hard-reload': () => shownId() && web.reload(shownId(), { ignoreCache: true }),
  'back': () => shownId() && web.back(shownId()),
  'forward': () => shownId() && web.forward(shownId()),
  'zoom-in': () => zoomBy(1),
  'zoom-out': () => zoomBy(-1),
  'zoom-reset': () => zoomBy(0),
  'find': () => openFind(),
  'find-next': () => (finding() ? findNext(false) : openFind()),
  'find-previous': () => (finding() ? findNext(true) : openFind()),
  'site-controls': () => shownSite() && siteControls.set(!siteControls()),
  'new-window': () => openNewWindow(),
  'new-private-window': () => openPrivateWindow(),
  'little-arc': () => openLittle(''),
  'settings': () => openSettings(),
  'next-tab': () => cycle(1),
  'previous-tab': () => cycle(-1),
  'next-space': () => apply(switchSpace(browser(), 'next')),
  'previous-space': () => apply(switchSpace(browser(), 'previous')),
  'clear-today': () => {
    const result = clearToday(browser())
    apply(result.state)
    pages.release(result.archived.map(tab => tab.id))
  },
  'split-view': () => splitWithNew(),
  'print': () => shownId() && web.print(shownId()).catch(() => {}),
  'view-source': () => viewSource(),
  'set-default-browser': () => craft.desktop.setDefaultBrowser().catch(() => {}),
  'library': () => openLibrary('archive'),
  'downloads': () => downloadsOpen.set(!downloadsOpen()),
  'escape': () => {
    if (permissionShown()) return answerPermission(false)
    if (zapping()) return stopZap()
    if (boostEditor()) return boostEditor.set(false)
    if (peek()) return closePeek()
    if (siteControls()) return siteControls.set(false)
    if (downloadsOpen()) return downloadsOpen.set(false)
    if (finding()) return finding.set(false)
    if (renaming()) return renaming.set(null)
    if (renamingSpace()) return renamingSpace.set(null)
    if (library()) return library.set(null)
    splitting = null
    if (commanding()) commanding.set(null)
  },
}

onMount(() => {
  craft.desktop.setMenus(browserMenus())
  // Sidebar changes and visits wait a moment to be sent together; quitting sends them now.
  if (!isPrivate) craft.desktop.onQuit?.(() => Promise.all([sessionClient.flush(), historyClient.flush()]))
  web.on('permission', onPermission)
  craft.desktop.onMessage(onWindowMessage)
  craft.desktop.onWindowClosed?.(onWindowClosed)
  // Which tabs this window shows, whenever that changes, so the others draw a card for them.
  let shownBefore = ''
  effect(() => {
    const tabs = showing()
    if (isPrivate || tabs.join() === shownBefore) return
    shownBefore = tabs.join()
    craft.desktop.post({ type: 'showing', tabs })
  })
  if (!isPrivate && !isExtraWindow) {
    craft.desktop.onOpenURL(urls => urls.forEach(openExternal))
    craft.desktop.takeOpenedURLs().then(urls => urls.forEach(openExternal)).catch(() => {})
  }
  web.on('state', (event) => {
    if (peek() && event.tab === peek().tab) peek.set({ ...peek(), url: event.url || peek().url, title: event.title || peek().title })
  })
  craft.desktop.onCommand((id) => {
    if (commands[id]) return commands[id]()
    const space = /^space-(\d)$/.exec(id)
    if (space && browser().spaces[Number(space[1]) - 1]) apply(switchSpace(browser(), browser().spaces[Number(space[1]) - 1].id))
    const favorite = /^favorite-(\d)$/.exec(id)
    if (favorite && favorites()[Number(favorite[1]) - 1]) show(favorites()[Number(favorite[1]) - 1].item.id)
  })
  web.on('state', (event) => {
    pageState.set({ ...pageState(), [event.tab]: event })
    historyClient.report(event)
    const item = browser().items[event.tab]
    if (item && (event.title || event.url)) apply(updateItem(browser(), event.tab, { ...(event.title ? { title: event.title } : {}), ...(event.url ? { url: event.url } : {}) }))
    // Each site keeps its own zoom.
    const site = settingsFor(sites(), siteKey(event.url))
    if (site && Math.abs((event.zoom || 1) - site.zoom) > 0.001) web.setZoom(event.tab, site.zoom)
  })
  web.on('favicon', event => apply(updateItem(browser(), event.tab, { icon: event.url })))
  web.on('open', (event) => {
    if (shouldPeek(browser(), event.tab, event.url)) return openPeek(event.url, event.child)
    if (event.child) {
      apply(openTab(browser(), { url: event.url, id: event.child }).state)
      pages.adopt(event.child)
    }
    else newTab(event.url, event.background)
  })
  web.on('close', event => close(event.tab))
  web.on('download', (event) => {
    const next = applyDownload(liveDownloads()[event.id], event)
    liveDownloads.set({ ...liveDownloads(), [event.id]: next })
    // Progress stays in the window; the agent keeps where it started and how it ended.
    if (event.state !== 'progress') libraryClient.recordDownload(next)
  })
  // Today's tabs left alone longer than the setting go to the archive.
  setInterval(() => {
    const idle = archiveAfterMs(settings().archiveAfter)
    if (!idle || isPrivate) return
    const result = autoArchive(browser(), Date.now(), idle)
    if (!result.archived.length) return
    apply(result.state)
    pages.release(result.archived.map(tab => tab.id))
  }, 5 * 60_000)
  // Pages left unseen go to sleep; their rows stay.
  setInterval(() => {
    // A page another window shows is that window's to put to sleep.
    const visible = new Set([...(shownId() ? [shownId()] : []), ...elsewhereTabs()])
    const busy = new Set(Object.values(pageState()).filter(page => page.camera || page.microphone).map(page => page.tab))
    const sleepy = tabsToSleep(pages.activity(browser(), visible, busy), Date.now())
    if (sleepy.length) pages.release(sleepy)
  }, 60_000)
  restore()
  // Settings before the blocker, so allowed sites are allowed from the first page.
  Promise.all([sitesClient.all(), boostClient.all()]).then(async ([all, saved]) => {
    sites.set(all)
    boosts.set(saved)
    await blocker.setBoosts(boostScripts(saved))
    await blocker.allow(unblockedHosts(all))
    if (settings().blocking) await blocker.sync({ cookieConsent: settings().cookieConsent })
  }).catch(error => console.error('Browser: the ad blocker could not start.', error)).finally(() => blockerReady.set(true))
})
</script>

<View class="flex-1 flex-row" :style="{ gradientDirection: 'to-b', gradientFrom: palette().background, gradientTo: palette().backgroundTo || palette().background }">
  <View :if="!sidebarOpen() && !peeking()" class="absolute bottom-0 left-0 top-0 w-[10px]" testID="sidebar-edge" @hover-change="peekSidebar($event.hovered)"></View>
  <View :if="sidebarShown() && restored()" class="gap-[6px] pb-[10px] pl-[10px] pr-[4px] w-[248px]" :style="sidebarOpen() ? {} : { position: 'absolute', left: 0, top: 0, bottom: 0, zIndex: 20, borderRadius: 12, shadowColor: '#000000', shadowOpacity: 0.25, shadowRadius: 18, gradientDirection: 'to-b', gradientFrom: palette().background, gradientTo: palette().backgroundTo || palette().background }" testID="sidebar" @hover-change="sidebarOpen() || peekSidebar($event.hovered)">
    <View class="flex-row gap-[2px] items-center justify-end pr-[2px] h-[44px]">
      <Button symbol="sidebar.left" variant="toolbar" iconOnly :style="textStyle()" testID="toggle-sidebar" @click="commands['toggle-sidebar']()" />
      <Button symbol="arrow.left" variant="toolbar" iconOnly :style="textStyle()" :disabled="!shownPage()?.canGoBack" testID="back" @click="commands.back()" />
      <Button symbol="arrow.right" variant="toolbar" iconOnly :style="textStyle()" :disabled="!shownPage()?.canGoForward" testID="forward" @click="commands.forward()" />
      <Button symbol="arrow.clockwise" variant="toolbar" iconOnly :style="textStyle()" testID="reload" @click="commands.reload()" />
    </View>

    <Pressable class="flex-row gap-[6px] items-center pl-[12px] pr-[4px] h-[34px] rounded-[10px] duration-150 transition" :style="{ backgroundColor: palette().hover }" testID="address" @press="openCommand('address')">
      <Icon :if="shownPage() && shownPage().secure" symbol="lock.fill" class="h-[11px] w-[11px]" :style="{ color: palette().foreground, opacity: 0.6 }" />
      <Text class="flex-1 text-[13px]" :style="textStyle()" :numberOfLines="1">{{ shownTab() ? displayHost(shownTab().url) : 'Search or enter address' }}</Text>
      <Button :if="shownSite()" symbol="slider.horizontal.3" variant="ghost" iconOnly class="text-[11px]" :style="textStyle()" testID="site-controls" @click="commands['site-controls']()" />
    </Pressable>

    <View :if="!isPrivate && favorites().length" class="flex-row gap-[8px] py-[4px]" @drop="dropOnFavorites($event)">
      <Pressable :for="row in favorites()" :key="row.item.id" class="flex-1 items-center justify-center h-[44px] bg-white/30 hover:bg-white/50 rounded-[12px] duration-150 transition" :style="rowStyle(row.item)" draggable :drag-data="row.item.id" :drag-url="row.item.url" :testID="'favorite-' + row.item.id" @press="show(row.item.id)" @contextmenu="openRowMenu(row.item)">
        <Image :if="iconFor(row.item)" :src="iconFor(row.item)" class="h-[18px] w-[18px]" @error="iconFailed(iconFor(row.item))" />
        <Icon :if="!iconFor(row.item)" name="globe" class="h-[18px] w-[18px]" />
      </Pressable>
    </View>
    <View :if="!isPrivate && !favorites().length" class="items-center justify-center h-[64px] bg-white/15 border border-white/60 rounded-[12px]" @drop="dropOnFavorites($event)">
      <Text class="font-semibold text-[12px]" :style="textStyle()">Drag to add Favorites</Text>
    </View>

    <Pressable class="flex-row gap-[8px] items-center pt-[6px] px-[8px] h-[30px]" testID="space-header" @contextmenu="openSpaceMenu(space().id)">
      <Icon :if="isSymbol(space().icon)" :symbol="space().icon" class="h-[14px] w-[14px]" :style="textStyle()" />
      <Text :if="!isSymbol(space().icon)" class="font-semibold text-[13px]" :style="textStyle()">{{ space().icon || '✦' }}</Text>
      <Text :if="renamingSpace() !== space().id" class="flex-1 font-semibold text-[13px]" :style="textStyle()" :numberOfLines="1">{{ space().name }}</Text>
      <TextInput :if="renamingSpace() === space().id" class="flex-1 font-semibold text-[13px]" :bordered="false" :value="spaceText()" autofocus select-text-on-focus testID="rename-space" @input="spaceText.set(textOf($event))" @submit="finishSpaceRename()" @blur="finishSpaceRename()" />
    </Pressable>

    <ScrollView class="flex-1">
      <Pressable :for="row in pinned()" :key="row.item.id" class="flex-row gap-[8px] items-center pr-[6px] h-[34px] hover:bg-white/35 rounded-[10px] duration-100 transition" :style="{ ...rowStyle(row), paddingLeft: 10 + row.depth * 16 }" draggable :drag-data="row.item.id" :drag-url="row.item.url || ''" :drop-inside="row.item.kind === 'folder'" :testID="'pinned-' + row.item.id" @press="row.item.kind === 'folder' ? apply(updateItem(browser(), row.item.id, { collapsed: !row.item.collapsed })) : show(row.item.id)" @contextmenu="openRowMenu(row.item)" @drop="drop(row, $event)" @hover-change="hoveredRow.set($event.hovered ? row.item.id : null)">
        <Icon :if="row.item.kind === 'folder'" :symbol="row.item.collapsed ? 'folder' : 'folder.fill'" class="h-[16px] w-[16px]" :style="textStyle()" />
        <Icon :if="isSplitRow(row)" symbol="rectangle.split.2x1" class="h-[16px] w-[16px]" :style="textStyle()" />
        <Image :if="row.item.kind === 'tab' && iconFor(row.item)" :src="iconFor(row.item)" class="h-[16px] w-[16px]" @error="iconFailed(iconFor(row.item))" />
        <Text :if="row.item.kind === 'tab' && !iconFor(row.item) && emojiFor(row.item)" class="w-[16px] text-[13px]">{{ emojiFor(row.item) }}</Text>
        <Icon :if="row.item.kind === 'tab' && !iconFor(row.item) && !emojiFor(row.item)" name="globe" class="h-[16px] w-[16px]" :style="textStyle()" />
        <Text :if="renaming() !== row.item.id" class="flex-1 text-[13px]" :style="textStyle()" :numberOfLines="1">{{ rowTitle(row) }}</Text>
        <TextInput :if="renaming() === row.item.id" class="flex-1 text-[13px]" :bordered="false" :value="renameText()" autofocus select-text-on-focus :testID="'rename-' + row.item.id" @input="renameText.set(textOf($event))" @submit="finishRename()" @blur="finishRename()" />
        <Button :if="hoveredRow() === row.item.id && row.item.kind === 'tab'" symbol="minus" variant="ghost" iconOnly class="text-[11px]" :testID="'unload-' + row.item.id" @click="close(row.item.id)" />
      </Pressable>

      <View class="flex-row gap-[8px] items-center my-[4px] px-[10px] h-[22px]">
        <View class="flex-1 h-[1px] bg-black/10"></View>
        <Pressable :if="today().length" class="justify-center px-[6px] h-[18px] hover:bg-white/40 rounded-[6px]" testID="clear-today" @press="commands['clear-today']()">
          <Text class="font-semibold text-[11px]" :style="{ color: palette().foreground, opacity: 0.6 }">Clear</Text>
        </Pressable>
      </View>

      <Pressable class="flex-row gap-[8px] items-center px-[10px] h-[34px] hover:bg-white/35 rounded-[10px] duration-100 transition" testID="new-tab" @press="openCommand('new')">
        <Icon name="plus" class="h-[16px] w-[16px]" :style="textStyle()" />
        <Text class="flex-1 text-[13px]" :style="{ color: palette().foreground, opacity: 0.75 }">New Tab</Text>
      </Pressable>

      <Pressable :for="row in today()" :key="row.item.id" class="flex-row gap-[8px] items-center pr-[6px] px-[10px] h-[34px] hover:bg-white/35 rounded-[10px] duration-100 transition" :style="rowStyle(row)" draggable :drag-data="row.item.id" :drag-url="row.item.url || ''" :testID="'today-' + row.item.id" @press="show(row.item.id)" @contextmenu="openRowMenu(row.item)" @drop="drop(row, $event)" @hover-change="hoveredRow.set($event.hovered ? row.item.id : null)">
        <Icon :if="isSplitRow(row)" symbol="rectangle.split.2x1" class="h-[16px] w-[16px]" :style="textStyle()" />
        <Image :if="!isSplitRow(row) && iconFor(row.item)" :src="iconFor(row.item)" class="h-[16px] w-[16px]" @error="iconFailed(iconFor(row.item))" />
        <Icon :if="!isSplitRow(row) && !iconFor(row.item)" name="globe" class="h-[16px] w-[16px]" :style="textStyle()" />
        <Text :if="renaming() !== row.item.id" class="flex-1 text-[13px]" :style="textStyle()" :numberOfLines="1">{{ rowTitle(row) }}</Text>
        <TextInput :if="renaming() === row.item.id" class="flex-1 text-[13px]" :bordered="false" :value="renameText()" autofocus select-text-on-focus :testID="'rename-' + row.item.id" @input="renameText.set(textOf($event))" @submit="finishRename()" @blur="finishRename()" />
        <Button :if="hoveredRow() === row.item.id && !isSplitRow(row)" symbol="xmark" variant="ghost" iconOnly class="text-[11px]" :testID="'close-' + row.item.id" @click="close(row.item.id)" />
      </Pressable>
    </ScrollView>

    <View class="flex-row gap-[10px] items-center justify-center h-[32px]">
      <Pressable :for="each in browser().spaces" :key="each.id" class="items-center justify-center h-[22px] w-[22px] rounded-full" :style="each.id === space().id ? { backgroundColor: palette().selected } : { backgroundColor: '#00000000' }" :testID="'space-' + each.id" @press="apply(switchSpace(browser(), each.id))" @contextmenu="openSpaceMenu(each.id)">
        <Icon :if="isSymbol(each.icon)" :symbol="each.icon" class="h-[11px] w-[11px]" :style="textStyle()" />
        <Text :if="!isSymbol(each.icon)" class="text-[11px]" :style="textStyle()">{{ each.icon || '●' }}</Text>
      </Pressable>
      <Button :if="!isPrivate" symbol="plus" variant="ghost" iconOnly class="text-[11px]" testID="add-space" @click="commands['new-space']()" />
      <Button :symbol="activeDownloads() ? 'arrow.down.circle.fill' : 'arrow.down.circle'" variant="ghost" iconOnly class="text-[11px]" :style="textStyle()" testID="downloads" @click="commands.downloads()" />
    </View>
  </View>

  <View class="flex-1 pb-[8px] pr-[8px] pt-[8px]" :style="sidebarOpen() ? {} : { paddingLeft: 8 }">
    <View :if="panes().length <= 1" class="overflow-hidden flex-1 rounded-[12px] shadow-lg" :style="{ backgroundColor: scheme() === 'dark' ? '#1d1e24' : '#ffffff' }">
      <WebView :if="!elsewhereTabs().has(shownId())" :tab="shownId()" class="flex-1" testID="content" />
      <View :if="shownId() && elsewhereTabs().has(shownId())" class="flex-1 gap-[12px] items-center justify-center" testID="shown-elsewhere">
        <Text class="text-[15px]" :style="{ color: '#6b6e8f' }">This tab is showing in another window.</Text>
        <Button title="Show Here" variant="primary" testID="show-here" @click="takeTab(shownId())" />
      </View>
      <View :if="progress() > 0" class="absolute left-0 top-0 h-[2px] bg-[#3b5bfd] duration-200 transition" :style="{ width: (progress() * 100) + '%' }"></View>
    </View>
    <View :if="panes().length > 1" class="flex-1 flex-row gap-[8px]">
      <View :for="pane in panes()" :key="pane.id" class="overflow-hidden flex-1 bg-white rounded-[12px] shadow-lg" :style="pane.id === shownId() ? { borderWidth: 2, borderColor: '#3b5bfd' } : { borderWidth: 2, borderColor: '#00000000' }">
        <Pressable class="flex-row gap-[6px] items-center px-[10px] h-[28px] bg-black/5" :testID="'pane-' + pane.id" @press="show(pane.id)">
          <Image :if="iconFor(pane)" :src="iconFor(pane)" class="h-[14px] w-[14px]" @error="iconFailed(iconFor(pane))" />
          <Text class="flex-1 text-[12px]" :style="{ color: '#3a3d5c' }" :numberOfLines="1">{{ titleOf(pane) }}</Text>
          <Button symbol="xmark" variant="ghost" iconOnly class="text-[10px]" :testID="'leave-' + pane.id" @click="apply(leaveSplit(browser(), pane.id))" />
        </Pressable>
        <WebView :if="!elsewhereTabs().has(pane.id)" :tab="pane.id" class="flex-1" :testID="'content-' + pane.id" />
        <View :if="elsewhereTabs().has(pane.id)" class="flex-1 gap-[10px] items-center justify-center">
          <Text class="text-[13px]" :style="{ color: '#6b6e8f' }">Showing in another window.</Text>
          <Button title="Show Here" variant="primary" :testID="'show-here-' + pane.id" @click="takeTab(pane.id)" />
        </View>
        <View :if="pane.id === shownId() && progress() > 0" class="absolute left-0 top-0 h-[2px] bg-[#3b5bfd] duration-200 transition" :style="{ width: (progress() * 100) + '%' }"></View>
      </View>
    </View>
  </View>

  <View :if="commanding()" class="absolute bottom-0 left-0 right-0 top-0 z-30 items-center pt-[120px] bg-black/10" testID="command-backdrop">
    <View class="overflow-hidden gap-[8px] p-[10px] w-[620px] bg-white/90 rounded-[16px] shadow-2xl" material="hud">
      <TextInput class="px-[8px] h-[40px] text-[18px]" :bordered="false" :value="commandText()" autofocus select-text-on-focus placeholder="Search or enter address" testID="command" @input="typeCommand($event)" @keydown="steer($event)" @submit="pick(highlighted())" />
      <View :if="results().length" class="h-[1px] bg-black/10"></View>
      <Pressable :for="(result, index) in results()" :key="result.kind + result.id" class="flex-row gap-[10px] items-center px-[10px] h-[40px] rounded-[10px]" :style="index === highlighted() ? { backgroundColor: '#3b5bfd' } : {}" :testID="'result-' + index" @press="pick(index)">
        <Image :if="result.icon" :src="result.icon" class="h-[16px] w-[16px]" />
        <Icon :if="!result.icon" :symbol="result.symbol" class="h-[16px] w-[16px]" :style="{ color: index === highlighted() ? '#ffffff' : '#3a3d5c' }" />
        <Text class="flex-1 text-[14px]" :style="{ color: index === highlighted() ? '#ffffff' : '#1b1d3a' }" :numberOfLines="1">{{ result.title }}</Text>
        <Text :if="result.kind === 'tab' || result.kind === 'pinned'" class="text-[12px]" :style="{ color: index === highlighted() ? '#ffffffcc' : '#6b6e8f' }">Switch to Tab</Text>
        <Text :if="result.kind === 'action'" class="text-[12px]" :style="{ color: index === highlighted() ? '#ffffffcc' : '#6b6e8f' }">Action</Text>
      </Pressable>
    </View>
  </View>

  <View :if="finding()" class="absolute right-[20px] top-[16px] z-20 flex-row gap-[6px] items-center p-[6px] w-[340px] bg-white/95 rounded-[12px] shadow-xl" material="hud" testID="find-bar">
    <TextInput class="flex-1 px-[6px] h-[28px] text-[13px]" :bordered="false" :value="findText()" autofocus select-text-on-focus placeholder="Find on page" testID="find" @input="typeFind($event)" @submit="findNext(false)" />
    <Text :if="findText() && !findFound()" class="text-[12px]" :style="{ color: '#c0392b' }">Not found</Text>
    <Button symbol="chevron.up" variant="ghost" iconOnly testID="find-previous" @click="findNext(true)" />
    <Button symbol="chevron.down" variant="ghost" iconOnly testID="find-next" @click="findNext(false)" />
    <Button symbol="xmark" variant="ghost" iconOnly testID="close-find" @click="finding.set(false)" />
  </View>

  <View :if="permissionShown()" class="absolute left-[300px] right-[40px] top-[16px] z-30 items-center" testID="permission">
    <View class="flex-row gap-[12px] items-center p-[14px] w-[460px] bg-white/95 rounded-[14px] shadow-2xl" material="hud">
      <Icon :symbol="permissionShown().kind === 'microphone' ? 'mic.fill' : 'video.fill'" class="h-[20px] w-[20px]" :style="{ color: '#3b5bfd' }" />
      <Text class="flex-1 text-[13px]" :style="{ color: '#1b1d3a' }">{{ permissionShown().origin + ' wants to use your ' + permissionWords(permissionShown().kind) + '.' }}</Text>
      <Button title="Don't Allow" variant="secondary" testID="deny-permission" @click="answerPermission(false)" />
      <Button title="Allow" variant="primary" testID="allow-permission" @click="answerPermission(true)" />
    </View>
  </View>

  <View :if="siteControls() && shownSite()" class="absolute left-[14px] top-[86px] z-30 gap-[10px] p-[14px] w-[300px] bg-white/95 rounded-[14px] shadow-2xl" material="hud" testID="site-panel">
    <View class="flex-row gap-[8px] items-center">
      <Icon :symbol="shownPage() && shownPage().secure ? 'lock.fill' : 'lock.open'" class="h-[14px] w-[14px]" :style="{ color: '#3a3d5c' }" />
      <Text class="flex-1 font-semibold text-[14px]" :style="{ color: '#1b1d3a' }" :numberOfLines="1">{{ shownSite().host }}</Text>
      <Button symbol="link" variant="ghost" iconOnly testID="site-copy" @click="commands['copy-url']()" />
    </View>
    <View class="h-[1px] bg-black/10"></View>
    <View class="flex-row items-center">
      <Text class="flex-1 text-[13px]" :style="{ color: '#1b1d3a' }">Block ads and trackers</Text>
      <Switch :value="shownSite().blocking" testID="site-blocking" @change="toggleBlocking()" />
    </View>
    <View class="flex-row gap-[6px] items-center">
      <Text class="flex-1 text-[13px]" :style="{ color: '#1b1d3a' }">Zoom</Text>
      <Button symbol="minus" variant="secondary" iconOnly testID="site-zoom-out" @click="zoomBy(-1)" />
      <Text class="w-[48px] text-[13px] text-center" :style="{ color: '#1b1d3a' }">{{ Math.round(shownSite().zoom * 100) + '%' }}</Text>
      <Button symbol="plus" variant="secondary" iconOnly testID="site-zoom-in" @click="zoomBy(1)" />
    </View>
    <View :for="kind in ['camera', 'microphone']" :key="kind" class="flex-row items-center">
      <Text class="flex-1 text-[13px]" :style="{ color: '#1b1d3a' }">{{ kind === 'camera' ? 'Camera' : 'Microphone' }}</Text>
      <Picker :value="shownSite()[kind]" :options="DEVICE_CHOICES" :testID="'site-' + kind" @change="setDevice(kind, $event.value || $event)" />
    </View>
    <View class="h-[1px] bg-black/10"></View>
    <Button title="Clear Cookies and Site Data" variant="ghost" testID="site-clear" @click="clearSiteData()" />
    <Button :title="shownBoost() ? 'Edit Boost' : 'Boost This Site'" variant="secondary" testID="site-boost" @click="openBoost()" />
  </View>

  <View :if="boostEditor() && shownBoost()" class="absolute bottom-[20px] right-[20px] top-[20px] z-30 gap-[10px] p-[14px] w-[360px] bg-white/95 rounded-[14px] shadow-2xl" material="hud" testID="boost-editor">
    <View class="flex-row gap-[8px] items-center">
      <Icon symbol="paintbrush" class="h-[16px] w-[16px]" :style="{ color: '#3b5bfd' }" />
      <Text class="flex-1 font-semibold text-[14px]" :style="{ color: '#1b1d3a' }" :numberOfLines="1">{{ shownBoost().name }}</Text>
      <Switch :value="shownBoost().enabled" testID="boost-enabled" @change="editBoost('enabled', !shownBoost().enabled)" />
      <Button symbol="xmark" variant="ghost" iconOnly testID="close-boost" @click="boostEditor.set(false)" />
    </View>
    <Button :title="zapping() ? 'Done Zapping' : 'Zap Elements'" :variant="zapping() ? 'primary' : 'secondary'" testID="boost-zap" @click="toggleZap()" />
    <Text class="text-[12px]" :style="{ color: '#6b6e8f' }">{{ zapping() ? 'Click anything on the page to hide it for good. Escape stops.' : shownBoost().zapped.length + ' zapped ' + (shownBoost().zapped.length === 1 ? 'element' : 'elements') }}</Text>
    <Text class="font-semibold text-[12px]" :style="{ color: '#6b6e8f' }">CSS</Text>
    <TextInput multiline class="flex-1 p-[8px] text-[12px]" :value="shownBoost().css" placeholder="body { font-family: Georgia }" testID="boost-css" @input="editBoost('css', textOf($event))" />
    <Text class="font-semibold text-[12px]" :style="{ color: '#6b6e8f' }">JavaScript (runs from the next load)</Text>
    <TextInput multiline class="p-[8px] h-[120px] text-[12px]" :value="shownBoost().js" placeholder="document.title = 'Boosted'" testID="boost-js" @input="editBoost('js', textOf($event))" />
    <View class="flex-row gap-[8px]">
      <Button :if="shownBoost().zapped.length" title="Bring Back Zapped" variant="ghost" testID="boost-unzap" @click="editBoost('zapped', [])" />
      <View class="flex-1"></View>
      <Button title="Delete Boost" variant="ghost" testID="boost-delete" @click="deleteBoost()" />
    </View>
  </View>

  <View :if="peek()" class="absolute bottom-0 left-0 right-0 top-0 z-30 items-center justify-center bg-black/25" testID="peek">
    <View class="overflow-hidden h-[86%] w-[78%] bg-white rounded-[14px] shadow-2xl">
      <View class="flex-row gap-[8px] items-center px-[12px] h-[36px] bg-[#f3f4f8]">
        <Text class="flex-1 font-semibold text-[12px]" :style="{ color: '#3a3d5c' }" :numberOfLines="1">{{ displayTitle(peek().title, peek().url) + '  ·  ' + displayHost(peek().url) }}</Text>
        <Button title="Open as Tab" variant="secondary" testID="peek-keep" @click="keepPeek()" />
        <Button symbol="xmark" variant="ghost" iconOnly testID="peek-close" @click="closePeek()" />
      </View>
      <WebView :tab="peek().tab" class="flex-1" testID="peek-content" />
    </View>
  </View>

  <View :if="downloadsOpen()" class="absolute bottom-[48px] left-[14px] z-30 gap-[6px] p-[10px] w-[300px] bg-white/95 rounded-[14px] shadow-2xl" material="hud" testID="downloads-panel">
    <View class="flex-row items-center px-[4px]">
      <Text class="flex-1 font-semibold text-[13px]" :style="{ color: '#1b1d3a' }">Downloads</Text>
      <Button title="Show All" variant="ghost" testID="downloads-all" @click="showAllDownloads()" />
    </View>
    <Text :if="!downloadList().length" class="py-[16px] text-[12px] text-center" :style="{ color: '#6b6e8f' }">Files you download show up here.</Text>
    <Pressable :for="download in downloadList().slice(0, 6)" :key="download.id" class="gap-[4px] px-[6px] py-[6px] hover:bg-black/5 rounded-[8px]" :testID="'download-' + download.id" @press="download.state === 'finished' ? web.openDownload(download.path).catch(() => {}) : null">
      <View class="flex-row gap-[8px] items-center">
        <Icon :symbol="download.state === 'failed' ? 'exclamationmark.circle' : 'doc'" class="h-[14px] w-[14px]" :style="{ color: '#3a3d5c' }" />
        <Text class="flex-1 text-[13px]" :style="{ color: '#1b1d3a' }" :numberOfLines="1">{{ download.name || download.url }}</Text>
        <Button :if="download.state === 'started'" symbol="xmark.circle" variant="ghost" iconOnly :testID="'cancel-' + download.id" @click="web.cancelDownload(download.id).catch(() => {})" />
        <Button :if="download.state === 'finished'" symbol="magnifyingglass" variant="ghost" iconOnly :testID="'show-' + download.id" @click="web.revealDownload(download.path).catch(() => {})" />
      </View>
      <View :if="download.state === 'started'" class="overflow-hidden h-[3px] bg-black/10 rounded-full">
        <View class="h-[3px] bg-[#3b5bfd]" :style="{ width: ((downloadFraction(download) ?? 0.1) * 100) + '%' }"></View>
      </View>
      <Text class="text-[11px]" :style="{ color: '#6b6e8f' }">{{ downloadDetail(download) }}</Text>
    </Pressable>
  </View>

  <View :if="onboarding()" class="absolute bottom-0 left-0 right-0 top-0 z-40 items-center justify-center bg-black/30" testID="onboarding">
    <View class="overflow-hidden flex-row h-[520px] w-[860px] bg-white rounded-[22px] shadow-2xl">
      <View class="flex-1 gap-[16px] justify-center p-[44px]">
        <Text class="font-semibold text-[#3b5bfd] text-[13px]">{{ onboarding() === 'welcome' ? 'WELCOME' : onboarding() === 'import' ? 'BRING YOUR ARC' : onboarding() === 'theme' ? 'MAKE IT YOURS' : onboarding() === 'default' ? 'ONE MORE THING' : 'LET\'S SETTLE IN' }}</Text>
        <Text class="font-bold text-[#14162e] text-[34px]">{{ onboarding() === 'welcome' ? 'A calmer way to browse.' : onboarding() === 'import' ? 'Your spaces, pinned tabs and history, right here.' : onboarding() === 'theme' ? 'Pick a colour for this space.' : onboarding() === 'default' ? 'Open your links here?' : 'A few keys worth knowing.' }}</Text>

        <Text :if="onboarding() === 'welcome'" class="text-[#4a4d6b] text-[15px]">Your tabs live in the sidebar, sorted into spaces. Pin what you keep, and let Today tidy itself. Ads and trackers are blocked from the start.</Text>

        <View :if="onboarding() === 'import'" class="gap-[10px]">
          <Text class="text-[#4a4d6b] text-[15px]">{{ !arcPreview() ? 'Looking for Arc…' : arcPreview().found ? 'Found in Arc: ' + importSummary(arcPreview().report, arcPreview().historyPages) + '. Arc\'s files are only read, never changed.' : 'Arc is not on this Mac, so there is nothing to bring over.' }}</Text>
          <Text :if="imported()" class="font-semibold text-[#1f8a4c] text-[14px]">{{ imported() }}</Text>
          <Text :if="arcPreview() && arcPreview().signIns && !signedIn()" class="text-[#4a4d6b] text-[14px]">{{ signInOffer(arcPreview().signIns) }}</Text>
          <Text :if="signedIn()" class="font-semibold text-[#1f8a4c] text-[14px]" testID="onboarding-signed-in">{{ signedIn() }}</Text>
        </View>

        <View :if="onboarding() === 'theme'" class="flex-row flex-wrap gap-[10px]">
          <Pressable :for="preset in THEME_PRESETS" :key="preset.id" class="items-center justify-center h-[44px] w-[44px] rounded-full" :style="{ gradientDirection: 'to-br', gradientFrom: preset.colors[0], gradientTo: preset.colors[1] || preset.colors[0], borderWidth: (space().theme.colors || []).join() === preset.colors.join() ? 3 : 0, borderColor: '#14162e' }" :testID="'theme-' + preset.id" @press="pickTheme(preset)"></Pressable>
        </View>

        <Text :if="onboarding() === 'default'" class="text-[#4a4d6b] text-[15px]">Links from Mail, Messages and every other app open in a small window over what you are doing, and move into the browser with one click.</Text>

        <View :if="onboarding() === 'done'" class="gap-[10px]">
          <View :for="tip in SETTLE_IN_TIPS" :key="tip.keys" class="flex-row gap-[12px] items-center">
            <View class="items-center justify-center px-[8px] h-[26px] min-w-[52px] bg-[#eef0fb] rounded-[7px]"><Text class="font-semibold text-[#3b5bfd] text-[12px]">{{ tip.keys }}</Text></View>
            <View class="flex-1"><Text class="font-semibold text-[#14162e] text-[13px]">{{ tip.title }}</Text><Text class="text-[#6b6e8f] text-[12px]">{{ tip.detail }}</Text></View>
          </View>
        </View>

        <View class="flex-row gap-[10px] pt-[8px]">
          <Button :if="onboarding() === 'import' && arcPreview() && arcPreview().found && !imported()" :title="importing() ? 'Importing…' : 'Import from Arc'" variant="primary" :disabled="importing()" testID="onboarding-import" @click="importArc()" />
          <Button :if="onboarding() === 'import' && arcPreview() && arcPreview().signIns && !signedIn()" :title="keepingSignIns() ? 'Waiting for the Keychain…' : 'Keep Me Signed In'" variant="secondary" :disabled="keepingSignIns()" testID="onboarding-cookies" @click="keepArcSignIns()" />
          <Button :if="onboarding() === 'default'" title="Make Default Browser" variant="primary" testID="onboarding-default" @click="onboardDefault()" />
          <Button :title="onboarding() === 'welcome' ? 'Get Started' : onboarding() === 'done' ? 'Start Browsing' : onboarding() === 'import' && !imported() && arcPreview() && arcPreview().found ? 'Skip' : onboarding() === 'default' ? 'Not Now' : 'Continue'" :variant="onboarding() === 'welcome' || onboarding() === 'done' || onboarding() === 'theme' || (onboarding() === 'import' && (imported() || (arcPreview() && !arcPreview().found))) ? 'primary' : 'secondary'" testID="onboarding-next" @click="advanceOnboarding()" />
        </View>
      </View>
      <View class="justify-end p-[30px] w-[320px]" :style="{ gradientDirection: 'to-br', gradientFrom: '#5b7bff', gradientTo: '#2a3fd6' }">
        <Text class="font-bold text-[22px] text-white">Browser</Text>
        <Text class="text-[#dfe5ff] text-[13px]">Native on your Mac. Pages in WebKit, everything else drawn by AppKit and run by zig-js.</Text>
      </View>
    </View>
  </View>

  <View :if="library()" class="absolute bottom-0 left-0 right-0 top-0 z-30 items-center justify-center bg-black/15" testID="library-backdrop">
    <View class="overflow-hidden gap-[10px] p-[14px] h-[560px] w-[720px] bg-white/95 rounded-[16px] shadow-2xl" material="hud" testID="library">
      <View class="flex-row gap-[6px] items-center">
        <Pressable :for="section in LIBRARY_SECTIONS" :key="section.id" class="justify-center px-[12px] h-[30px] rounded-[8px]" :style="library() === section.id ? { backgroundColor: '#3b5bfd' } : { backgroundColor: '#0000000d' }" :testID="'library-' + section.id" @press="openLibrary(section.id)">
          <Text class="font-semibold text-[13px]" :style="{ color: library() === section.id ? '#ffffff' : '#1b1d3a' }">{{ section.title }}</Text>
        </Pressable>
        <View class="flex-1"></View>
        <Button :if="library() === 'downloads'" title="Clear" variant="ghost" testID="clear-downloads" @click="libraryClient.clearDownloads().then(() => openLibrary('downloads'))" />
        <Button symbol="xmark" variant="ghost" iconOnly testID="close-library" @click="library.set(null)" />
      </View>
      <TextInput :if="library() === 'history'" class="px-[8px] h-[32px] text-[14px]" :value="libraryText()" autofocus placeholder="Search history" testID="library-search" @input="typeLibrary($event)" />
      <ScrollView class="flex-1">
        <Text :if="!libraryGroups().length" class="py-[40px] text-[13px] text-center" :style="{ color: '#6b6e8f' }">{{ library() === 'archive' ? 'Tabs you close or clear stay here for 30 days.' : library() === 'history' ? 'Pages you visit show up here.' : 'Files you download show up here.' }}</Text>
        <View :for="group in libraryGroups()" :key="group.label" class="gap-[2px] pb-[10px]">
          <Text class="px-[8px] py-[4px] font-semibold text-[11px]" :style="{ color: '#6b6e8f' }">{{ group.label }}</Text>
          <Pressable :for="entry in group.entries" :key="entry.id || entry.url" class="flex-row gap-[10px] items-center px-[8px] h-[40px] hover:bg-black/5 rounded-[8px]" :testID="'entry-' + (entry.id || entry.url)" @press="openFromLibrary(entry)">
            <Icon :symbol="library() === 'downloads' ? 'arrow.down.circle' : library() === 'archive' ? 'archivebox' : 'clock'" class="h-[16px] w-[16px]" :style="{ color: '#3a3d5c' }" />
            <View class="flex-1">
              <Text class="text-[13px]" :style="{ color: '#1b1d3a' }" :numberOfLines="1">{{ entryTitle(entry) }}</Text>
              <Text class="text-[11px]" :style="{ color: '#6b6e8f' }" :numberOfLines="1">{{ entryDetail(entry) }}</Text>
            </View>
            <Button :if="library() === 'downloads' && entry.path" symbol="magnifyingglass" variant="ghost" iconOnly :testID="'reveal-' + entry.id" @click="web.revealDownload(entry.path).catch(() => {})" />
            <Button :if="library() === 'history'" symbol="trash" variant="ghost" iconOnly :testID="'forget-' + entry.url" @click="libraryClient.forgetPage(entry.url).then(() => visitedPages.set(visitedPages().filter(page => page.url !== entry.url)))" />
          </Pressable>
        </View>
      </ScrollView>
    </View>
  </View>
</View>
